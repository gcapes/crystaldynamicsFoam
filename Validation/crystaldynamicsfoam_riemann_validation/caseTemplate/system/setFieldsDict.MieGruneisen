FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue rho 8930
    volScalarFieldValue e   0
);

regions
(
    boxToCell
    {
        box (-1 -1 -1) (0.005 1 1);
        fieldValues
        (
            volScalarFieldValue rho 10579.45
            volScalarFieldValue e   320000
        );
    }
);

