FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


libs
(
    "libROUNDSchemes.so" 
);


application     CPFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         1.4e-9;      // slowest (shear) front reaches the last probe
                             // at ~1.25 ns; the pressure wave arrives earlier

deltaT          1e-14;

writeControl    adjustableRunTime;
writeInterval   2e-10;

purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable yes;

// Explicit stress coupling: maxDeltaT must respect the acoustic CFL of the
// FASTEST wave, c_p = 5991.45 m/s.  dy = 5e-6/2400 = 2.083 nm:
//   maxDeltaT = 0.3*dy/c_p ~ 1.0e-13 s
adjustTimeStep  yes;
maxCo           0.3;
maxDeltaT       1.0e-13;

functions
{
    probes
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   1;
        fields          (U);
        probeLocations
        (
            (0 4.4e-6 2.5e-6)
            (0 4.0e-6 2.5e-6)
            (0 3.6e-6 2.5e-6)
            (0 3.2e-6 2.5e-6)
            (0 2.8e-6 2.5e-6)
            (0 2.4e-6 2.5e-6)
            (0 2.0e-6 2.5e-6)
            (0 1.6e-6 2.5e-6)
            (0 1.2e-6 2.5e-6)
        );
    }
}

