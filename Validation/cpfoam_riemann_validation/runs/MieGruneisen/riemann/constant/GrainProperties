/*--------------------------------*- C++ -*----------------------------------*\
  Solid Riemann (Sod-type) problem: single-crystal copper, [100] axis.
  MieGruneisen is substituted by Allrun (MieGruneisen | linearElastic).

  This file doubles as the reference documentation for every dictionary
  entry introduced by the Mie-Gruneisen EOS extension.  Entries are
  grouped as GLOBAL (top level of GrainProperties) and PER-MATERIAL
  (inside each Material.<i> sub-dictionary).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      GrainProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

N_Phases                    1;
N_Materials                 1;
Phase2Material              (0);

n_constitutive_substeps     50;

stressUpdate                true;
PF_drivingForceActive       false;
verbose                     false;

// ===========================================================================
//  EOS EXTENSION -- GLOBAL ENTRIES
// ===========================================================================

// EOSMode : selects the volumetric closure.                    [word]
//
//   linearElastic  (DEFAULT if entry absent)
//       Legacy behaviour, byte-identical code path: pressure is carried
//       inside the hypo-elastic stress rate; the implied closure is
//       p = K (rho/rho0 - 1) with K = (C11 + 2 C12)/3, athermal.
//       All pre-existing tutorial cases run unchanged.
//
//   MieGruneisen
//       Shock-physics closure.  The constitutive kernel in StressUpdate.H
//       evolves per-phase stress DEVIATORS only; the volumetric stress
//       -(p + q) I is supplied algebraically by EOS.H from the conserved
//       state (rho, e); the energy equation solves specific internal
//       energy e (EEqn.H) in place of Cv*T (TEqn.H); the adaptive time
//       step is limited by the acoustic Courant number.
//       Requires: stressUpdate = true; per-material c0, s_UsUp, Gamma0
//       below; fvSchemes entries div(rhoPhi,e) and laplacian(kByCv,e).
EOSMode                     MieGruneisen;

// EOS_Tref : reference temperature of the EOS.                 [K]  (opt.)
//       Defines the zero of specific internal energy: e = 0 at
//       (rho = rho0, T = EOS_Tref, p = 0).  Fresh starts initialise
//       e = Cv (T - EOS_Tref); a start with uniform T = EOS_Tref is
//       therefore stress-free, matching the legacy start.  Set equal to
//       the initial temperature unless you WANT initial thermal stress
//       Gamma0*rho0*Cv*(T - Tref).  Default: 300.0.
EOS_Tref                    300.0;

// EOS_qQuad, EOS_qLinear : artificial-viscosity coefficients.  [-]  (opt.)
//       Compression-only von Neumann-Richtmyer (quadratic) and Landshoff
//       (linear) shock viscosity,
//           q = rho dx ( Cq dx (trD)^2 + Cl c |trD| ),   trD < 0,
//       added to the pressure channel so it dissipates consistently in
//       momentum AND energy (q's work is shock heating).  It spreads a
//       captured shock over ~3-5 cells and suppresses the colocated
//       grad-then-div ringing.  Defaults (1.2, 0.06) are standard
//       hydrocode values; raise Cq toward 2 if a very strong shock still
//       rings, lower toward 0.7 to sharpen fronts in smooth problems.
//       Inert when EOSMode = linearElastic.
EOS_qQuad                   1.2;
EOS_qLinear                 0.06;

// (Derived, not an input:  cL0_bound.  At start-up the code computes a
//  conservative longitudinal wave-speed upper bound per material from
//  the largest Mandel diagonal of C_ijkl, stored on the Material class
//  and used for the acoustic CFL.  It is printed in the solver header.)

// ===========================================================================

// --- Initial lattice orientation (Bunge Euler angles, radians): cube ---
phi1                        (0.0);
phi2                        (0.0);
phi3                        (0.0);

// --- Phase-field machinery (inert here: single phase, PF_drivingForceActive off) ---
interface_width             4.0e-5;

Energy
(
    (Material.0 Material.0)    0.5
);

Mobility
(
    (Material.0 Material.0)    1.0e-12
);

// ===========================================================================

Material.0
{
    // Thermophysical (copper).  NOTE: rho_0 and Cv also feed the EOS --
    // rho_0 is the Mie-Gruneisen reference density (mu = rho/rho_0 - 1)
    // and Cv sets the e <-> T map, T = Tref + (e - e_ref(mu))/Cv.
    rho_0       8930.0;
    Cv          385.0;
    kappa       385.0;

    // =======================================================================
    //  EOS EXTENSION -- PER-MATERIAL ENTRIES  (required when MieGruneisen)
    // =======================================================================

    // c0 : bulk sound speed at the reference state.            [m/s]
    //      Intercept of the linear Us-up Hugoniot, Us = c0 + s*up.
    //      For thermodynamic consistency with the elastic constants,
    //      c0 ~ sqrt(K/rho_0) with K = (C11+2C12)/3; small (~1%)
    //      mismatches between shock-derived c0 and ultrasonic K are
    //      normal in the literature and immaterial (the deviator uses
    //      C_ijkl, the pressure uses the EOS).  Copper: 3940.
    c0          3940.0;

    // s_UsUp : slope of the linear Us-up Hugoniot.              [-]
    //      THE finite-amplitude stiffening parameter (cold-curve
    //      curvature).  Metals: 1.2-1.6.  The legacy closure behaves as
    //      an effective s ~ 0.5, which is the defect the EOS repairs.
    //      Values are tabulated in the LASL Shock Hugoniot Data
    //      compilation and Meyers' textbook.  Copper: 1.489.
    //      A warning is issued for s < 1; the Hugoniot form has a pole
    //      at mu = 1/(s-1), guarded by a clamp at 0.95/(s-1).
    s_UsUp      1.489;

    // Gamma0 : Gruneisen parameter at the reference state.      [-]
    //      Thermal-pressure coefficient: p gains Gamma0*rho_0*(e - e_ref).
    //      Governs everything OFF the principal Hugoniot -- release
    //      isentropes (THIS benchmark), reshock, thermal stress -- and is
    //      invisible to a Us-up fit (on the Hugoniot e = e_H identically).
    //      The code uses the standard rho*Gamma = rho_0*Gamma0 closure.
    //      Metals: 1.5-2.5.  Copper: 1.99.
    Gamma0      1.99;

    // =======================================================================

    // Cubic elastic constants (copper): C11 = 168.4, C12 = 121.4,
    // C44 = 75.4 GPa.  All symmetry-equivalent permutations supplied.
    C0000       168.4e9;
    C1111       168.4e9;
    C2222       168.4e9;

    C0011       121.4e9;
    C1100       121.4e9;
    C0022       121.4e9;
    C2200       121.4e9;
    C1122       121.4e9;
    C2211       121.4e9;

    C0101       75.4e9;
    C0110       75.4e9;
    C1001       75.4e9;
    C1010       75.4e9;

    C0202       75.4e9;
    C0220       75.4e9;
    C2002       75.4e9;
    C2020       75.4e9;

    C1212       75.4e9;
    C1221       75.4e9;
    C2112       75.4e9;
    C2121       75.4e9;

    // Crystal plasticity: minimised strength (flow stress ~50 MPa at
    // shock strain rates) so the volumetric closure is isolated; the
    // release head then rides the BULK isentrope characteristic rather
    // than a strength-dominated elastic-unloading precursor.  See README.
    N_slips         12;
    initialCRSS     2.0e6;
    tau_S           4.0e6;
    h_0             0.0;
    r               1.0;
    k_exponent      5.0;
    gammadot_0      1.0;

    // FCC {111}<110>, normalised (m = direction, n = plane normal)
    m0  ( 0.0                 0.7071067811865476 -0.7071067811865476);
    n0  ( 0.5773502691896258  0.5773502691896258  0.5773502691896258);
    m1  ( 0.7071067811865476  0.0                -0.7071067811865476);
    n1  ( 0.5773502691896258  0.5773502691896258  0.5773502691896258);
    m2  ( 0.7071067811865476 -0.7071067811865476  0.0               );
    n2  ( 0.5773502691896258  0.5773502691896258  0.5773502691896258);

    m3  ( 0.0                 0.7071067811865476 -0.7071067811865476);
    n3  (-0.5773502691896258  0.5773502691896258  0.5773502691896258);
    m4  ( 0.7071067811865476  0.0                 0.7071067811865476);
    n4  (-0.5773502691896258  0.5773502691896258  0.5773502691896258);
    m5  ( 0.7071067811865476  0.7071067811865476  0.0               );
    n5  (-0.5773502691896258  0.5773502691896258  0.5773502691896258);

    m6  ( 0.0                 0.7071067811865476  0.7071067811865476);
    n6  ( 0.5773502691896258 -0.5773502691896258  0.5773502691896258);
    m7  ( 0.7071067811865476  0.0                -0.7071067811865476);
    n7  ( 0.5773502691896258 -0.5773502691896258  0.5773502691896258);
    m8  ( 0.7071067811865476  0.7071067811865476  0.0               );
    n8  ( 0.5773502691896258 -0.5773502691896258  0.5773502691896258);

    m9  ( 0.0                 0.7071067811865476  0.7071067811865476);
    n9  ( 0.5773502691896258  0.5773502691896258 -0.5773502691896258);
    m10 ( 0.7071067811865476  0.0                 0.7071067811865476);
    n10 ( 0.5773502691896258  0.5773502691896258 -0.5773502691896258);
    m11 ( 0.7071067811865476 -0.7071067811865476  0.0               );
    n11 ( 0.5773502691896258  0.5773502691896258 -0.5773502691896258);
}

// ************************************************************************* //
