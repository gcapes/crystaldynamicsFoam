FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    // Catch-all for the advected microstructure history fields
    // (g_alpha.*, gamma_alphas.*, Rot*, n.*, per-phase sigma.*)
    default             Gauss vanLeer;

    div(phi,rho)        Gauss WENOUpwindFit 2 1;//div(phi,rho)        Gauss vanLeer;
    div(rhoPhi,U)       Gauss WENOUpwindFit 2 1;//div(rhoPhi,U)       Gauss limitedLinearV 1;
    div(sigma)          Gauss linear;
    div((sigma&U))      Gauss linear;

    // Legacy energy equation (EOSMode linearElastic)
    div((Cv*rhoPhi),T)  Gauss vanLeer;

    // EOS-mode energy equation (EOSMode MieGruneisen)
    div(rhoPhi,e)       Gauss WENOUpwindFit 2 1;;//div(rhoPhi,e)       Gauss vanLeer;
}

laplacianSchemes
{
    default             Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

