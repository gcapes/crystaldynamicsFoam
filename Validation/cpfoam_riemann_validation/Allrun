#!/bin/sh
# =========================================================================
#  Solid Riemann (Sod-type) problem for CPFoam.
#
#  Usage:   ./Allrun [MieGruneisen|linearElastic|both]     (default: both)
#           APP=/path/to/CPFoam ./Allrun both
#
#  Pure initial-value problem (no piston): left half = Hugoniot(800 m/s)
#  state at rest, right half ambient.  setFields writes the mode-specific
#  initial discontinuity (MG: rho + e; legacy: rho + sigma.0, since the
#  legacy closure carries its pressure inside the integrated stress).
# =========================================================================
cd "$(dirname "$0")" || exit 1

APP="${APP:-CPFoam}"
MODE="${1:-both}"

command -v "$APP" >/dev/null 2>&1 || {
    echo "Solver '$APP' not found in PATH."
    echo "Build CPFoam (with the EOS extension) and re-run, or set APP=."
    exit 1
}

run_one() {
    mode="$1"
    d="runs/$mode/riemann"
    echo "== EOSMode = $mode =="
    rm -rf "$d"
    mkdir -p "runs/$mode"
    cp -r caseTemplate "$d"
    cp "$d/system/setFieldsDict.$mode" "$d/system/setFieldsDict"
    sed -i "s/MODE_PLACEHOLDER/$mode/g" "$d/constant/GrainProperties"
    (
        cd "$d" || exit 1
        blockMesh > log.blockMesh 2>&1 || {
            echo "  blockMesh FAILED (see $d/log.blockMesh)"; exit 1; }
        setFields > log.setFields 2>&1 || {
            echo "  setFields FAILED (see $d/log.setFields)"; exit 1; }
        if "$APP" > log.CPFoam 2>&1; then
            echo "  complete"
        else
            echo "  FAILED (see $d/log.CPFoam)"
        fi
    ) &
}

case "$MODE" in
    both)
        run_one MieGruneisen
        run_one linearElastic
        wait
        ;;
    MieGruneisen|linearElastic)
        run_one "$MODE"
        wait
        ;;
    *)
        echo "usage: ./Allrun [MieGruneisen|linearElastic|both]"
        exit 1
        ;;
esac

if command -v python3 >/dev/null 2>&1; then
    python3 validate_riemann.py
else
    echo "python3 not found: run validate_riemann.py manually."
fi
