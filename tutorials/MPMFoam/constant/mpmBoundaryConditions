FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mpmBoundaryConditions;
}

velocityBCs
{
    lowerWall
    {
        type        fixedValue;
        value       (0 0 0);        // Fixed (no-slip)
    }
    
    atmosphere
    {
        type        fixedValue;
        value       (0 -0.1 0);     // Moving down at 0.1 m/s (compression)
    }
    
    leftWall
    {
        type        symmetry;       // Lateral constraint
    }
    
    rightWall
    {
        type        symmetry;       // Lateral constraint
    }
    
    Front
    {
        type        empty;          // 2D case
    }
    Back
    {
        type        empty;          // 2D case
    }
}
