FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      materialProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Define materials used in simulation

  nMaterials  3;  

material0
{
    name                aluminum;
    rho                 2700.0;
    youngModulus        70e9;
    poissonRatio        0.33;
    crystalStructure    FCC;
    initialCRSS         50e60;
    saturationStress    500e6;
    hardeningRate       1e9;
    latentHardeningRatio 1.4;
    refSlipRate         1e-3;
    rateExponent        20.0;
}

material1
{
    name                copper;
    rho                 8960.0;
    youngModulus        130e9;
    poissonRatio        0.34;
    crystalStructure    FCC;
    initialCRSS         40e60;
    saturationStress    450e6;
    hardeningRate       1.2e9;
    latentHardeningRatio 1.4;
    refSlipRate         1e-3;
    rateExponent        20.0;
}

material2
{
    name                steel;
    rho                 7850.0;
    youngModulus        200e9;
    poissonRatio        0.30;
    crystalStructure    FCC;  // Use FCC for now (or implement BCC)
    initialCRSS         60e60;
    saturationStress    550e6;
    hardeningRate       1.5e9;
    latentHardeningRatio 1.4;
    refSlipRate         1e-3;
    rateExponent        20.0;
}



