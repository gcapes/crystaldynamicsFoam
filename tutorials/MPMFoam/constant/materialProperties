FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      materialProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Define materials used in simulation

    material0
    {
        // Material type: elastic, elastoPlastic, neoHookean
        type            elastic;
        
        // Density [kg/m^3]
        rho             1000.0;
        
        // Young's modulus [Pa]
        E               1.0e6;
        
        // Poisson's ratio [-]
        nu              0.3;
        
        // For elastoPlastic materials:
        // yieldStress     1.0e5;   // [Pa]
        // hardeningModulus 1.0e4;  // [Pa]
    }
;

