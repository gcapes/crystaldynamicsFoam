FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      particleBoundaryConditions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// COMPRESSION/EXTRACTION CASE
// ============================
// Inflow:  'atmosphere' with velocity (0 100 0)
// Outflow: 'Front' with velocity (0 0 -100)

particleBoundaryTypes
{
    // INFLOW: Particles spawn here, pushed into domain
    atmosphere
    {
        type        wall;
        behavior    stick;
    }
    
    // OUTFLOW: Particles LEAVE domain here
    Front
    {
        type        outflow;
    }
    
    // SOLID WALLS: Particles stick
    lowerWall
    {
        type        wall;
        behavior    stick;
    }
    
    Back
    {
        type        wall;
        behavior    stick;
    }
    
    // 2D CASE: Empty patches
    leftWall
    {
        type        empty;
    }
    
    rightWall
    {
        type        empty;
    }
}

defaultBehavior
{
    type        wall;
    behavior    stick;
}

