FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mpmBoundaryConditions;
}

velocityBCs
{
    lowerWall
    {
        type        fixedValue;
        value       (0 0 10);        // Fixed (no-slip)
    }
    
    atmosphere
    {
             type        fixedValue;
        value       (0 0.0 -10.0);
    }
    
    leftWall
    {
    type        empty;          // 2D case
 
    }
    
    rightWall
    {
    type        empty;          // 2D case
   
    }
    
    Front
    {
        type        fixedValue;
        value       (0 10.0 0);
    }
    Back
    {
        type        fixedValue;
        value       (0 -10.0 0);
    }
}
