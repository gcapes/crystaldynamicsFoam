// Define materials used in simulation

  nMaterials  3;  
  
  
  material0
{
    Mat_type        "Titanium";
    rho_0           4506;
    Cv              523;
    kappa           21.9;
    
    elasticType     cubic;
    C11             162.4e9;        // Pa
    C33             180.7e9;        // Pa
    C12             92.0e9;         // Pa
    C13             69.0e9;         // Pa
    C44             46.7e9;         // Pa
    // C66 is automatically calculated: C66 = (C11 - C12)/2
    
    // Crystal plasticity for HCP
    crystalStructure    HCP;
    N_Slips         12;             // 3 basal + 3 prismatic + 6 pyramidal
    initial_CRSS    50.0e6;
    ref_shear_rate  1.0e-3;
    k_exponent      25.0;
}
  
