FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mpmBoundaryConditions;
}

velocityBCs
{
    lowerWall
    {
             type        fixedValue;
        value       (0 -100.0 0.0 );
    }
    
    atmosphere
    {
             type        fixedValue;
        value       (0 100.0 0.0 );
    }
    
    leftWall
    {
    type        empty;          // 2D case
 
    }
    
    rightWall
    {
    type        empty;          // 2D case
   
    }
    
    Front
    {
               type        fixedValue;
        value       (0 0 -100.0);        // Fixed (no-slip)
    }
    Back
    {
               type        fixedValue;
        value       (0 0 100.0);        // Fixed (no-slip)
    }
}
