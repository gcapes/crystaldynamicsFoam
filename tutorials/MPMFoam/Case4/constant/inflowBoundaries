// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// PARAMETER GUIDE
// ===============
//
// Required:
// ---------
// patch               : Name of boundary patch
// velocity            : Inflow velocity vector [m/s]
// materialID          : Material index (0, 1, 2, ...)
// particlesPerCell    : Target particles per cell (8-12 recommended)
//
// Optional - Nucleation:
// ----------------------
// minDensityFraction  : Spawn when count < this * particlesPerCell (default: 0.5)
// randomizePositions  : true/false (default: false)
//
// Optional - Stress Initialization:
// ----------------------------------
// stressInitialization : "zero", "hydrostatic", "uniaxial", or "acoustic"
//   
//   For "hydrostatic":
//     pressure : Hydrostatic pressure [Pa] (positive = compression)
//   
//   For "uniaxial":
//     stress    : Uniaxial stress [Pa] (positive = tension)
//     direction : Direction vector (will be normalized)
//   
//   For "acoustic":
//     (no extra parameters - computed from velocity and material)
//
// Optional - Spawn Strategy:
// ---------------------------
// spawnStrategy : "cellCenter", "nearBoundary", or "layered"
//   
//   For "layered":
//     spawnDepth : Number of cell layers to monitor (default: 1)
//
// Optional - Crystal Orientation:
// --------------------------------
// grainID : Grain identifier (default: 0)
// phi1    : Bunge angle α [radians] (default: 0)
// Phi     : Bunge angle β [radians] (default: 0)
// phi2    : Bunge angle γ [radians] (default: 0)
