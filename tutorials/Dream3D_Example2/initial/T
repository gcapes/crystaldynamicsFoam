FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 800;

boundaryField
{
       xMin
    {
        type            zeroGradient;
    }
        xMax
    {
        type            zeroGradient;
    }
    yMin
    {
        type            zeroGradient;
    }

    yMax
    {
        type            zeroGradient;
    }

    zMin
    {
        type            fixedValue;
        value         uniform 800.0;
    }

    zMax
    {
        type            fixedValue;
        value         uniform 800.0;
    }

    defaultFaces
    {
        type            empty;
    }
}

