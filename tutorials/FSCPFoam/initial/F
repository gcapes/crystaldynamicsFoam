FoamFile
{
    version     2.0;
    format      ascii;
    class       volTensorField;
    location    "0";
    object      F;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform (1 0 0 0 1 0 0 0 1);

boundaryField
{

    Front
    {
type zeroGradient;
       
    }
    Back
    {
type zeroGradient;
    }
    
    lowerWall
    {
type zeroGradient;
    }
    atmosphere
    {
type zeroGradient;
    }
    defaultFaces
    {
        type            empty;
    }
}


