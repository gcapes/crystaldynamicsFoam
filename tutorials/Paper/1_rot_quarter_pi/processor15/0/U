        type            uniformFixedValue;
        uniformValue    
        {
            type            table;
            values          
5
(
(0 (0 0 0))
(1e-07 (0 500 0))
(2e-07 (0 0 0))
(3e-07 (0 -500 0))
(4e-07 (0 0 0))
)
;
        }
        value           uniform (0 0 0);
    }
    atmosphere
    {
        type            slip;
    }
    rightWall
    {
        type            empty;
    }
    leftWall
    {
        type            empty;
    }
    frontAndBack
    {
        type            slip;
    }
    procBoundary15to10
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary15to13
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary15to14
    {
        type            processor;
