FoamFile
{
    format      ascii;
    class       volTensorField;
    location    "3e-08";
    object      Omega_P;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform (0 0 0 0 0 0 0 0 0);

boundaryField
{
    lowerWall
    {
        type            zeroGradient;
    }
    atmosphere
    {
        type            zeroGradient;
    }
    rightWall
    {
        type            empty;
    }
    leftWall
    {
        type            empty;
    }
    frontAndBack
    {
        type            zeroGradient;
    }
    procBoundary3to1
    {
        type            processor;
        value           uniform (0 0 0 0 0 0 0 0 0);
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform (0 0 0 0 0 0 0 0 0);
    }
}


