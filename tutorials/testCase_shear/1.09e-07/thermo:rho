FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "1.09e-07";
    object      thermo:rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 7800;

boundaryField
{
    lowerWall
    {
        type            calculated;
        value           uniform 7800;
    }
    atmosphere
    {
        type            calculated;
        value           uniform 7800;
    }
    rightWall
    {
        type            empty;
    }
    leftWall
    {
        type            empty;
    }
    frontAndBack
    {
        type            calculated;
        value           uniform 7800;
    }
}


