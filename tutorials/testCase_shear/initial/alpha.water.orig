FoamFile
{
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    frontAndBack
    {
    type            zeroGradient;
    }
    leftWall
    {
        type            empty;
    }

    rightWall
    {
        type            empty;
    }

    lowerWall
    {
        type            zeroGradient;
    }

    atmosphere
    {
       type            zeroGradient;
    }

    defaultFaces
    {
        type            empty;
    }
}

// ************************************************************************* //
