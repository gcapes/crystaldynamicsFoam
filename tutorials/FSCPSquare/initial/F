FoamFile
{
    version     2.0;
    format      ascii;
    class       volTensorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform (1 0 0 0 1 0 0 0 1);

boundaryField
{
	frontAndBack{
type zeroGradient;
	}
    lowerWall
    {
        // (undeformed material being pushed in)
        type            fixedValue;
        value           uniform (1 0 0 0 1 0 0 0 1);
    }
    atmosphere
    {
type zeroGradient;
    }
    defaultFaces
    {
        type            empty;
    }
}


