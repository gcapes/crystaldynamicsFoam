FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
libs
(
    "libROUNDSchemes.so" 
);

application     crystaldynamicsFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         15e-3;

deltaT          1e-6;

writeControl    none;

writeInterval   2.5e-4;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.1;
maxAlphaCo      0.1;

maxDeltaT       1e-4;

functions
{
    writeSelected
    {
        type            writeObjects;
        libs            ("libutilityFunctionObjects.so");
        objects         (sigmaGlobal GBREF "n\.[0-9]+" W_mech W_interface dpdt_crack);
        writeControl    adjustableRunTime;
        writeInterval   2.5e-4;
        timeStart       0;
    }
}
