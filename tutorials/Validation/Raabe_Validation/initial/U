FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ===================================================================
//  Plane-strain compression: u = (0, +edot*y, -edot*z)
//
//  EVERY face gets BOTH Uy and Uz prescribed from the same
//  analytical velocity gradient.  A time ramp over t_ramp avoids
//  the instantaneous stress spike at t=0 that causes FPE at corners.
//
//  edot = V_peak / L = 50 / 2e-4 = 250,000 /s
//  t_ramp = 5e-9 s  (~50 timesteps at dt=1e-10)
// ===================================================================

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{

    // z = 0 face (Front)
    Front
    {
        type codedFixedValue;
        value $internalField;
        name planeStrainFront;
        code
        #{
            const scalar edot  = 250000.0;
            const scalar t_ramp = 5e-9;
            const scalar t = this->db().time().value();
            const scalar ramp = Foam::min(t / t_ramp, 1.0);

            vectorField veloc(patch().size(), vector(0, 0, 0));
            const vectorField& cf = patch().Cf();
            forAll(cf, i)
            {
                veloc[i].x() = 0.0;
                veloc[i].y() = ramp * edot * cf[i].y();
                veloc[i].z() = 0.0;  // z = 0 on this face
            }
            operator==(veloc);
        #};
    }

    // z = 0.2mm face (Back)
    Back
    {
        type codedFixedValue;
        value $internalField;
        name planeStrainBack;
        code
        #{
            const scalar edot  = 250000.0;
            const scalar t_ramp = 5e-9;
            const scalar t = this->db().time().value();
            const scalar ramp = Foam::min(t / t_ramp, 1.0);

            vectorField veloc(patch().size(), vector(0, 0, 0));
            const vectorField& cf = patch().Cf();
            forAll(cf, i)
            {
                veloc[i].x() = 0.0;
                veloc[i].y() = ramp * edot * cf[i].y();
                veloc[i].z() = ramp * (-edot) * cf[i].z();
            }
            operator==(veloc);
        #};
    }

    // y = 0.2mm face (lowerWall)
    lowerWall
    {
        type codedFixedValue;
        value $internalField;
        name planeStrainLowerWall;
        code
        #{
            const scalar edot  = 250000.0;
            const scalar t_ramp = 5e-9;
            const scalar t = this->db().time().value();
            const scalar ramp = Foam::min(t / t_ramp, 1.0);

            vectorField veloc(patch().size(), vector(0, 0, 0));
            const vectorField& cf = patch().Cf();
            forAll(cf, i)
            {
                veloc[i].x() = 0.0;
                veloc[i].y() = ramp * edot * cf[i].y();
                veloc[i].z() = ramp * (-edot) * cf[i].z();
            }
            operator==(veloc);
        #};
    }

    // y = 0 face (atmosphere)
    atmosphere
    {
        type codedFixedValue;
        value $internalField;
        name planeStrainAtmosphere;
        code
        #{
            const scalar edot  = 250000.0;
            const scalar t_ramp = 5e-9;
            const scalar t = this->db().time().value();
            const scalar ramp = Foam::min(t / t_ramp, 1.0);

            vectorField veloc(patch().size(), vector(0, 0, 0));
            const vectorField& cf = patch().Cf();
            forAll(cf, i)
            {
                veloc[i].x() = 0.0;
                veloc[i].y() = 0.0;  // y = 0 on this face
                veloc[i].z() = ramp * (-edot) * cf[i].z();
            }
            operator==(veloc);
        #};
    }

    defaultFaces
    {
        type            empty;
    }
}

