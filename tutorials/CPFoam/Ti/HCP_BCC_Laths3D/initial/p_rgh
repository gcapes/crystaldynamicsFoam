FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
   Back
    {
             type            fixedValue;
        value         uniform 0.0;
    }
        front
    {
             type            fixedValue;
        value         uniform 0.0;
    }
    leftWall
    {
                     type            fixedValue;
        value         uniform 0.0;
    }

    rightWall
    {
                     type            fixedValue;
        value         uniform 0.0;
    }

    lowerWall
    {
       type            zeroGradient;
    }

    atmosphere
    {
         type            fixedValue;
        value         uniform 0.0;
    }

    defaultFaces
    {
        type            empty;
    }
}

