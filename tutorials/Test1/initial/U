FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
	frontAndBack{
            type            zeroGradient;
	}
    lowerWall
    {
    
    type uniformFixedValue;
    uniformValue table
    (
        (0 (0 0 0))
        (50.0e-8 (0 1e3 0))
        (100.0e-8 (0 -1e3 0))
        (150e-8 (0 0 0))
    );

/*
        type            fixedValue;
        value           uniform (0 100 0);
*/
    }
    atmosphere
    {
    type            noSlip;
//    type            slip;
    
  /*  
type pressureInletOutletVelocity;
phi phi;
rho rho;
tangentialVelocity uniform (0 0 0);
value uniform (0 0 0.0);
*/
    }
    defaultFaces
    {
        type            empty;
    }
}


