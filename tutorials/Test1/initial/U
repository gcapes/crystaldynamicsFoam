FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
	frontAndBack{
            type            noSlip;
	}
    lowerWall
    {
    type uniformFixedValue;
    uniformValue table
    (
        (0 (0 0 0))
        (5.0e-7 (0 1e-5 1e-5))
        (10.0e-7 (0 1e-5 1e-5))
        (15e-7 (0 -1e-5 -1e-5))
        (20e-7 (0 -1e-5 -1e-5))
        (25e-7 (0 0 0))
    );

    }
    atmosphere
    {
    type            noSlip;
    /*
    
type pressureInletOutletVelocity;
phi phi;
rho rho;
tangentialVelocity uniform (0 0 0);
value uniform (0 0 0.0);
*/
    }
    defaultFaces
    {
        type            empty;
    }
}


